rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Clients
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // CRM Leads
    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Projects
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Tasks
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // SMM Content Assets
    match /contentAssets/{contentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Ad Campaigns
    match /adCampaigns/{campaignId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Financial Transactions (Ledger)
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Employees
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Purchase Orders
    match /purchaseOrders/{poId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Hardware & Software Assets
    match /assets/{assetId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Leave Requests
    match /leaveRequests/{leaveId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // System Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // System Config & Rewards
    match /system_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /reward_redemptions/{redemptionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Real-Time Team Chat Channels & Messages
    match /chatChannels/{channelId} {
      allow read: if true;
      allow write: if true;
    }

    match /chatMessages/{messageId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

